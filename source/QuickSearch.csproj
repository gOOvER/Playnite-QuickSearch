<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{4FDF1E89-5BC3-4C72-8FDA-0D580E7A5D5F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>QuickSearch</RootNamespace>
    <AssemblyName>QuickSearch</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress NuGet audit warning for legacy packages required by host -->
    <NoWarn>$(NoWarn);NU1903;NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Localization files must be Content (copied to output), not compiled XAML Pages -->
  <ItemGroup>
    <Page Remove="Localization\**" />
    <Content Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Remove="QuickSearchSDK\**" />
    <Compile Remove="QuickSearchSDK.Attributes\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\noise.png" />
    <Content Include="QuickSearch.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.18.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="3.0.5" />
    <PackageReference Include="F23.StringSimilarity" Version="4.1.0" />
    <PackageReference Include="HtmlRenderer.WPF" Version="1.5.1-beta1" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="LibGit2Sharp" Version="0.26.2" />
    <PackageReference Include="Lucene.Net" Version="3.0.3" />
    <PackageReference Include="Lucene.Net.Contrib" Version="3.0.3" />
    <PackageReference Include="MdXaml_migfree" Version="1.11.0" />
    <PackageReference Include="Octokit" Version="0.50.0" />
    <PackageReference Include="StartPage.SDK" Version="1.0.0" />
    <PackageReference Include="YamlDotNet" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\extern\PlayniteCommon\PlayniteCommon.csproj" />
    <ProjectReference Include="QuickSearchSDK\QuickSearchSDK.csproj" />
    <ProjectReference Include="QuickSearchSDK.Attributes\QuickSearchSDK.Attributes.csproj" />
  </ItemGroup>
</Project>