<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <RootNamespace>QuickSearch</RootNamespace>
    <AssemblyName>QuickSearchSDK</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress NuGet audit warning for Newtonsoft.Json 10.0.3 -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.18.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickSearchSDK.Attributes\QuickSearchSDK.Attributes.csproj" />
  </ItemGroup>
</Project>